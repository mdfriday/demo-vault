{
  "$schema": "https://mdfriday.com/schemas/capability-manifest/v1",
  "name": "bilibili",
  "version": "1.0.0",
  "type": "shortcode",
  "description": "Embed Bilibili videos with responsive 16:9 container.",
  "entry": "shortcode:bilibili",
  "config": {
    "scope": "shortcode",
    "params": [
      { "key": "id", "in": "shortcode-param", "type": "string", "required": true, "description": "Bilibili BV ID (e.g. BV1xx411c7mD)", "example": "BV1xx411c7mD" },
      { "key": "title", "in": "shortcode-param", "type": "string", "required": false, "default": "Bilibili Video", "description": "Accessible title", "example": "My Video" }
    ],
    "usage": "{{< bilibili id=\"BV1xx411c7mD\" >}}"
  },
  "assets": { "css": null, "js": [], "future_lazy_load": false, "size_impact": "~0KB local" },
  "locked": { "html_ids": [], "html_data_attrs": [], "js_files": [], "reason": "No locked elements" },
  "child_override": {
    "css": null,
    "css_in_main": { "classes": [".mdf-video-wrapper", ".bilibili-wrapper"] },
    "partials": [{ "file": "layouts/_shortcodes/bilibili.html", "level": "safe" }]
  }
}


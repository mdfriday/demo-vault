{
  "$schema": "https://mdfriday.com/schemas/capability-manifest/v1",
  "name": "utterances",
  "version": "1.0.0",
  "type": "shortcode",
  "description": "GitHub Issues-based comment system. Readers sign in with GitHub to leave comments stored as Issues in your repo.",

  "entry": "shortcode:utterances",

  "config": {
    "scope": "shortcode",
    "params": [
      {
        "key": "repo",
        "in": "shortcode-param",
        "type": "string",
        "required": true,
        "description": "GitHub repository in 'owner/repo' format",
        "example": "myname/my-blog",
        "effect": "Comments are stored as Issues in this repository"
      },
      {
        "key": "theme",
        "in": "shortcode-param",
        "type": "string",
        "required": false,
        "default": "github-light",
        "description": "Utterances color theme",
        "example": "github-dark",
        "allowed_values": ["github-light", "github-dark", "preferred-color-scheme", "github-dark-orange", "icy-dark", "dark-blue", "photon-dark"]
      },
      {
        "key": "term",
        "in": "shortcode-param",
        "type": "string",
        "required": false,
        "default": "pathname",
        "description": "How to map pages to Issues",
        "example": "pathname",
        "allowed_values": ["pathname", "url", "title", "og:title"]
      }
    ],
    "usage": "{{< utterances repo=\"owner/repo\" theme=\"github-dark\" >}}"
  },

  "assets": {
    "css": null,
    "js": [
      {
        "file": null,
        "cdn": "https://utteranc.es/client.js",
        "size": "~10KB (CDN)",
        "locked": true,
        "note": "Loaded from utteranc.es CDN. No local file."
      }
    ],
    "future_lazy_load": false,
    "size_impact": "~0KB local — CDN loaded at runtime"
  },

  "locked": {
    "html_ids": [],
    "html_data_attrs": [],
    "js_files": [],
    "reason": "No local locked files."
  },

  "child_override": {
    "css": null,
    "partials": [
      {
        "file": "layouts/_shortcodes/utterances.html",
        "level": "safe",
        "note": "Can modify wrapper class, or set default repo/theme values"
      }
    ]
  }
}


{
  "$schema": "https://mdfriday.com/schemas/capability-manifest/v1",
  "name": "x",
  "version": "1.0.0",
  "type": "shortcode",
  "description": "Embed X (formerly Twitter) posts via Twitter's oEmbed widget.",
  "entry": "shortcode:x",
  "config": {
    "scope": "shortcode",
    "params": [
      { "key": "user", "in": "shortcode-param", "type": "string", "required": true, "description": "X/Twitter username (without @)", "example": "mdfriday" },
      { "key": "id", "in": "shortcode-param", "type": "string", "required": true, "description": "Tweet/post ID (from the URL)", "example": "1234567890123456789" }
    ],
    "usage": "{{< x user=\"mdfriday\" id=\"1234567890123456789\" >}}"
  },
  "assets": { "css": null, "js": [{ "file": null, "cdn": "https://platform.twitter.com/widgets.js", "size": "~50KB CDN", "locked": true }], "size_impact": "~0KB local" },
  "locked": { "html_ids": [], "html_data_attrs": [], "js_files": [], "reason": "No local locked files" },
  "child_override": { "css": null, "partials": [{ "file": "layouts/_shortcodes/x.html", "level": "safe" }] }
}


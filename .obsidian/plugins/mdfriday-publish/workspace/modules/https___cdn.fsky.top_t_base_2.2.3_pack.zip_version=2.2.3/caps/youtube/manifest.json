{
  "$schema": "https://mdfriday.com/schemas/capability-manifest/v1",
  "name": "youtube",
  "version": "1.0.0",
  "type": "shortcode",
  "description": "Embed YouTube videos with responsive 16:9 aspect ratio container.",
  "entry": "shortcode:youtube",
  "config": {
    "scope": "shortcode",
    "params": [
      { "key": "id", "in": "shortcode-param", "type": "string", "required": true, "description": "YouTube video ID (from the URL after ?v=)", "example": "dQw4w9WgXcQ" },
      { "key": "title", "in": "shortcode-param", "type": "string", "required": false, "default": "YouTube Video", "description": "Accessible title for the iframe", "example": "My Tutorial" },
      { "key": "autoplay", "in": "shortcode-param", "type": "string", "required": false, "description": "Set to 'true' to autoplay", "example": "true" }
    ],
    "usage": "{{< youtube id=\"dQw4w9WgXcQ\" title=\"My Video\" >}}"
  },
  "assets": {
    "css": null, "js": [],
    "future_lazy_load": false,
    "size_impact": "~0KB local — iframe loaded from YouTube CDN",
    "css_note": "Override .mdf-video-wrapper .youtube-wrapper in main.css for container sizing"
  },
  "locked": { "html_ids": [], "html_data_attrs": [], "js_files": [], "reason": "No locked elements" },
  "child_override": {
    "css": null,
    "css_in_main": { "classes": [".mdf-video-wrapper", ".youtube-wrapper"], "note": "Style the iframe container in main.css" },
    "partials": [{ "file": "layouts/_shortcodes/youtube.html", "level": "safe", "note": "Can modify iframe attributes or container HTML" }]
  }
}


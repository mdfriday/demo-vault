    {
      "name": "d3",
      "url": "https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js",
      "version": "7"
    },
    {
      "name": "pixi.js",
      "url": "https://cdn.jsdelivr.net/npm/pixi.js@8.0.0/dist/pixi.min.js",
      "version": "8.0.0"
